APP_ENV=development
# Required; at least 32 characters. Replace before deploying.
PAYLOAD_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
DATABASE_URI=postgres://postgres@127.0.0.1:5432/payload_elysia
PORT=3000
SERVER_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:5173

# Initial superadmin seed. Unset means no admin is seeded.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=password123

# Dashboard Environment Variables
VITE_API_URL=http://localhost:3000

# UAT OpenAPI Documentation Basic Auth (required when APP_ENV=uat)
OPENAPI_DOCS_USER=uat-admin
OPENAPI_DOCS_PASSWORD=uat-secret123

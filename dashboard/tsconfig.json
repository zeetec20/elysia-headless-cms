{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "types": ["vite/client", "bun"],
    // NOTE: The first '@' match resolves into this workspace; the second covers the cross-workspace
    // Eden app types reached from 'payload-elysia-api/server' (api/src uses the same alias).
    "paths": {
      "@/*": ["./src/*", "../api/src/*"],
      "@payload-config": ["../api/src/payload.config.ts"]
    }
  },
  "include": ["src", "scripts", "vite.config.ts"],
  "exclude": ["node_modules"]
}

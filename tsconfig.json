{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "payload-elysia-api": ["./api/src/server.ts"],
      "payload-elysia-api/*": ["./api/src/*"],
      "payload-elysia-api/server": ["./api/src/server.ts"],
      "payload-elysia-api/payload-types": ["./api/src/payload-types.ts"]
    }
  },
  "references": [{ "path": "./api" }, { "path": "./dashboard" }]
}

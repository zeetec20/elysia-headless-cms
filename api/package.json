{
  "name": "payload-elysia-api",
  "version": "1.0.0",
  "type": "module",
  "types": "./src/server.ts",
  "exports": {
    ".": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./payload-types": {
      "types": "./src/payload-types.ts",
      "default": "./src/payload-types.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch --conditions=development src/server.ts",
    "start": "bun --conditions=development src/server.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "generate:types": "bun --conditions=development ./node_modules/payload/bin.js generate:types --disable-transpile",
    "generate:openapi": "bun --conditions=development scripts/generate-openapi.ts",
    "seed": "bun --conditions=development scripts/seed.ts",
    "migrate": "bun --conditions=development ./node_modules/payload/bin.js migrate --disable-transpile",
    "migrate:status": "bun --conditions=development ./node_modules/payload/bin.js migrate:status --disable-transpile",
    "migrate:create": "bun --conditions=development ./node_modules/payload/bin.js migrate:create --disable-transpile",
    "migrate:down": "bun --conditions=development ./node_modules/payload/bin.js migrate:down --disable-transpile",
    "migrate:refresh": "bun --conditions=development ./node_modules/payload/bin.js migrate:refresh --disable-transpile",
    "migrate:reset": "bun --conditions=development ./node_modules/payload/bin.js migrate:reset --disable-transpile",
    "test": "bun --conditions=development test"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "drizzle-orm": "0.45.2",
    "payload": "^3.91.0",
    "payload-oapi": "^0.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
